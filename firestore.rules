rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function mainAdmin() { return signedIn() && request.auth.token.email == 'merveillematondo2027@gmail.com'; }
    function admin() { return mainAdmin() || (signedIn() && request.auth.token.admin == true); }
    function userData() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function role() { return signedIn() ? userData().role : null; }
    function professional() { return signedIn() && role() in ['AGENT', 'AGENCY', 'OWNER']; }
    function auditor() { return signedIn() && role() == 'STATE_AUDITOR'; }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || admin());
      allow create: if signedIn()
        && request.auth.uid == userId
        && (request.resource.data.role == 'client' || admin());
      allow update: if admin() || (
        signedIn()
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'verificationStatus', 'permissions', 'isAdmin', 'accreditationCode'
        ])
      );
      allow delete: if admin();
    }

    match /accessRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.requestedRole in ['AGENT', 'AGENCY', 'OWNER']
        && request.resource.data.status == 'pending';
      allow read: if admin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if admin();
    }

    match /listings/{listingId} {
      allow read: if resource.data.status == 'ACTIVE'
        || admin()
        || (signedIn() && resource.data.publishedBy.id == request.auth.uid);

      allow create: if admin() || (
        professional()
        && request.resource.data.publishedBy.id == request.auth.uid
        && request.resource.data.status == 'PENDING_REVIEW'
      );

      allow update: if admin() || (
        signedIn()
        && resource.data.publishedBy.id == request.auth.uid
        && request.resource.data.publishedBy.id == resource.data.publishedBy.id
        && request.resource.data.status == resource.data.status
      );

      allow delete: if admin() || (
        signedIn()
        && resource.data.publishedBy.id == request.auth.uid
        && resource.data.status != 'ACTIVE'
      );
    }

    match /properties/{propertyId} {
      allow read: if true;
      allow create: if admin() || (
        professional()
        && request.resource.data.ownerId == request.auth.uid
      );
      allow update: if admin() || auditor() || (
        signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.verificationStatus == resource.data.verificationStatus
      );
      allow delete: if admin() || (
        signedIn()
        && resource.data.ownerId == request.auth.uid
        && resource.data.verificationStatus != 'VERIFIED'
      );
    }

    match /favorites/{favoriteId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || admin());
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && (resource.data.userId == request.auth.uid || admin());
    }

    match /carts/{cartId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || admin());
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && (resource.data.userId == request.auth.uid || admin());
    }

    match /visitRequests/{requestId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update: if admin() || (
        signedIn()
        && (resource.data.userId == request.auth.uid || resource.data.agentId == request.auth.uid)
      );
      allow delete: if admin();
    }

    match /conversations/{conversationId} {
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participantIds.size() >= 2;
      allow read, update: if admin() || (
        signedIn() && request.auth.uid in resource.data.participantIds
      );
      allow delete: if admin();

      match /messages/{messageId} {
        allow read: if admin() || (
          signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
        );
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow update: if admin() || (
          signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt'])
        );
        allow delete: if admin();
      }
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || admin());
      allow create: if admin() || auditor();
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if admin();
    }

    match /inquiries/{inquiryId} {
      allow create: if signedIn() && request.resource.data.senderId == request.auth.uid;
      allow read, update: if admin() || (
        signedIn()
        && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid)
      );
      allow delete: if admin();
    }

    match /journal/{journalId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if admin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if false;
    }

    match /auditLogs/{logId} {
      allow create: if signedIn() && request.resource.data.actorId == request.auth.uid;
      allow read: if admin() || auditor();
      allow update, delete: if false;
    }

    match /sponsoredAds/{adId} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    match /appSettings/{settingId} {
      allow read: if true;
      allow write: if admin();
    }

    match /transactions/{transactionId} {
      allow read: if admin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if admin();
    }

    match /dailyReports/{reportId} {
      allow read, write: if admin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
